{
  "manifest_version": 3,
  "name": "Segue",
  "version": "1.2.0",
  "description": "Right-click a link and send it to another browser window, or Alt-click to send it to a window you choose once.",
  "icons": {
    "16": "icons/segue-16.png",
    "32": "icons/segue-32.png",
    "48": "icons/segue-48.png",
    "128": "icons/segue-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/segue-16.png",
      "32": "icons/segue-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Segue — name this window"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ],
  "commands": {
    "move-tab-next": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Move this tab to the next window"
    },
    "move-tab-prev": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Move this tab to the previous window"
    }
  }
}
